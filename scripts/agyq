#!/usr/bin/env python3
"""
Antigravity Gemini Quota Checker (agyq)

Checks Google Gemini model quota remaining for Antigravity accounts:
- m47 (default / antigravity)
- anv (antigravity-anv)
- mgh (antigravity-mgh)
"""

import argparse
import datetime
import hashlib
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

ACCOUNT_CONFIGS = {
    "m47": {
        "displayName": "Antigravity",
        "instanceId": "antigravity-m47",
        "candidateInstanceIds": ["antigravity-m47", "antigravity"],
        "description": "Primary account (m47)",
    },
    "anv": {
        "displayName": "Antigravity (ANV)",
        "instanceId": "antigravity",
        "candidateInstanceIds": ["antigravity", "antigravity-anv"],
        "description": "Secondary account (anv)",
    },
    "mgh": {
        "displayName": "Antigravity (MGH)",
        "instanceId": "antigravity-mgh",
        "candidateInstanceIds": ["antigravity-mgh"],
        "description": "Tertiary account (mgh)",
    },
}

DEFAULT_CLIENT_ID = os.environ.get("ANTIGRAVITY_CLIENT_ID") or os.environ.get(
    "GOOGLE_CLIENT_ID", "dummy-client-id.apps.googleusercontent.com"
)
DEFAULT_CLIENT_SECRET = os.environ.get("ANTIGRAVITY_CLIENT_SECRET") or os.environ.get(
    "GOOGLE_CLIENT_SECRET", "dummy-client-secret"
)
QUOTA_USER_AGENT = "antigravity/hub/2.9.1 linux/amd64"


def get_default_oauth_credentials():
    """Attempt to find valid Google OAuth client_id and client_secret."""
    cid = os.environ.get("ANTIGRAVITY_CLIENT_ID") or os.environ.get("GOOGLE_CLIENT_ID")
    csec = os.environ.get("ANTIGRAVITY_CLIENT_SECRET") or os.environ.get("GOOGLE_CLIENT_SECRET")
    if cid and csec and cid != "dummy-client-id.apps.googleusercontent.com":
        return cid, csec

    t3_providers_root = os.path.expanduser("~/.t3/userdata/providers/antigravity")
    if os.path.isdir(t3_providers_root):
        try:
            for hdir in os.listdir(t3_providers_root):
                acp_file = os.path.join(t3_providers_root, hdir, "antigravity-acp", "acp_token.json")
                if os.path.isfile(acp_file):
                    try:
                        with open(acp_file, "r", encoding="utf-8") as f:
                            td = json.load(f)
                        if td.get("client_id") and td.get("client_id") != "dummy-client-id.apps.googleusercontent.com":
                            return td.get("client_id"), td.get("client_secret", DEFAULT_CLIENT_SECRET)
                    except Exception:
                        pass
        except Exception:
            pass

    return DEFAULT_CLIENT_ID, DEFAULT_CLIENT_SECRET


def resolve_t3_instance_id(profile_key: str, settings_path: str | None = None) -> str | None:
    """Find the T3 provider instance ID corresponding to a given profile key from settings.json."""
    if settings_path is None:
        settings_path = os.path.expanduser("~/.t3/userdata/settings.json")
    if not os.path.exists(settings_path):
        return None
    try:
        with open(settings_path, "r", encoding="utf-8") as f:
            settings = json.load(f)
        provider_instances = settings.get("providerInstances", {})
        if not isinstance(provider_instances, dict):
            return None

        profile_lower = profile_key.lower()

        # 1. Match specific profile keywords in displayName (e.g. "ANV", "M47", "MGH", "Antigravity (ANV)")
        for inst_id, cfg in provider_instances.items():
            if cfg.get("driver") and cfg.get("driver") != "antigravity":
                continue
            disp = str(cfg.get("displayName", "")).strip().lower()
            if disp == profile_lower or f"({profile_lower})" in disp or f" {profile_lower}" in disp:
                return inst_id

        # 2. Match instance ID suffix (e.g. antigravity-m47, antigravity-anv, antigravity-mgh)
        target_slug = f"antigravity-{profile_lower}"
        if target_slug in provider_instances:
            return target_slug
        if profile_lower in provider_instances:
            return profile_lower

        # 3. For m47, if "antigravity" instance exists and does NOT belong to anv/mgh
        if profile_lower == "m47" and "antigravity" in provider_instances:
            disp = str(provider_instances["antigravity"].get("displayName", "")).strip().lower()
            if not any(k in disp for k in ["anv", "mgh"]):
                return "antigravity"

        return None
    except Exception:
        return None


def resolve_account_token(profile_key: str, settings_path: str | None = None):
    cfg = ACCOUNT_CONFIGS.get(profile_key)
    if not cfg:
        return None, f"Unknown profile: {profile_key}"

    # 1. Look in T3 ACP provider directory via dynamic settings.json or candidate instance IDs
    t3_instance_id = resolve_t3_instance_id(profile_key, settings_path=settings_path)
    candidate_ids = []
    if t3_instance_id:
        candidate_ids.append(t3_instance_id)
    for cid in cfg.get("candidateInstanceIds", [cfg.get("instanceId")]):
        if cid not in candidate_ids:
            candidate_ids.append(cid)

    for instance_id in candidate_ids:
        inst_hash = hashlib.sha256(instance_id.encode("utf-8")).hexdigest()
        t3_acp_path = os.path.expanduser(
            f"~/.t3/userdata/providers/antigravity/{inst_hash}/antigravity-acp/acp_token.json"
        )
        if os.path.exists(t3_acp_path):
            try:
                with open(t3_acp_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if data.get("refresh_token"):
                    return data, None
            except Exception:
                pass

    # 2. Look in gemini profiles directory
    profile_path = os.path.expanduser(f"~/.gemini/antigravity-cli/profiles/{profile_key}")
    if os.path.exists(profile_path):
        try:
            with open(profile_path, "r", encoding="utf-8") as f:
                data = json.load(f)
            rt = data.get("token", {}).get("refresh_token") or data.get("refresh_token")
            if rt:
                cid, csec = get_default_oauth_credentials()
                return {
                    "client_id": data.get("client_id") or cid,
                    "client_secret": data.get("client_secret") or csec,
                    "refresh_token": rt,
                }, None
        except Exception:
            pass

    # 3. Fallback for m47: default token (only if not conflicting with known secondary profiles)
    if profile_key == "m47":
        default_tok = os.path.expanduser("~/.gemini/antigravity-cli/antigravity-oauth-token")
        if os.path.exists(default_tok):
            try:
                with open(default_tok, "r", encoding="utf-8") as f:
                    data = json.load(f)
                rt = data.get("token", {}).get("refresh_token") or data.get("refresh_token")
                if rt:
                    is_other_profile = False
                    for other_k in ["anv", "mgh"]:
                        other_p = os.path.expanduser(f"~/.gemini/antigravity-cli/profiles/{other_k}")
                        if os.path.exists(other_p):
                            try:
                                with open(other_p, "r", encoding="utf-8") as of:
                                    odata = json.load(of)
                                ort = odata.get("token", {}).get("refresh_token") or odata.get("refresh_token")
                                if ort == rt:
                                    is_other_profile = True
                                    break
                            except Exception:
                                pass
                    if not is_other_profile:
                        cid, csec = get_default_oauth_credentials()
                        return {
                            "client_id": data.get("client_id") or cid,
                            "client_secret": data.get("client_secret") or csec,
                            "refresh_token": rt,
                        }, None
            except Exception:
                pass

    return None, f"Credentials not found for profile '{profile_key}'"


def fetch_quota_summary(access_token: str) -> dict | None:
    """Fetch live grouped quota summary from Google Cloud Code partner APIs."""
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "User-Agent": QUOTA_USER_AGENT,
    }
    endpoints = [
        "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
        "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
    ]
    for url in endpoints:
        try:
            req = urllib.request.Request(url, data=b"{}", headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                if data.get("groups"):
                    return data
        except Exception:
            continue
    return None


def get_gemini_quota(token_dict: dict):
    client_id = token_dict.get("client_id") or DEFAULT_CLIENT_ID
    client_secret = token_dict.get("client_secret") or DEFAULT_CLIENT_SECRET
    refresh_token = token_dict.get("refresh_token")

    if not refresh_token:
        raise ValueError("Missing refresh_token in credentials")

    refresh_payload = urllib.parse.urlencode({
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": refresh_token,
        "grant_type": "refresh_token",
    }).encode("utf-8")

    token_req = urllib.request.Request(
        "https://oauth2.googleapis.com/token",
        data=refresh_payload,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
    )
    with urllib.request.urlopen(token_req, timeout=15) as resp:
        token_res = json.loads(resp.read().decode("utf-8"))

    access_token = token_res.get("access_token")
    if not access_token:
        raise ValueError("Failed to retrieve access token from Google OAuth")

    # 1. Prefer live retrieveUserQuotaSummary which contains measured real-time quota windows
    summary = fetch_quota_summary(access_token)
    if summary:
        gemini_group = None
        for g in summary.get("groups", []):
            if "gemini" in g.get("displayName", "").lower():
                gemini_group = g
                break

        if gemini_group:
            h5_bucket = None
            weekly_bucket = None
            for b in gemini_group.get("buckets", []):
                bid = b.get("bucketId", "")
                win = b.get("window", "")
                if bid == "gemini-5h" or win == "5h":
                    h5_bucket = b
                elif bid == "gemini-weekly" or win == "weekly":
                    weekly_bucket = b

            target_bucket = h5_bucket or weekly_bucket
            if target_bucket:
                rem_frac = float(target_bucket.get("remainingFraction", 0.0))
                res = {
                    "modelName": "Gemini Pool",
                    "remainingPercent": rem_frac * 100.0,
                    "usedPercent": (1.0 - rem_frac) * 100.0,
                    "resetTime": target_bucket.get("resetTime"),
                    "description": target_bucket.get("description"),
                }
                if weekly_bucket and weekly_bucket != target_bucket:
                    w_rem = float(weekly_bucket.get("remainingFraction", 0.0))
                    res["weeklyRemainingPercent"] = w_rem * 100.0
                    res["weeklyUsedPercent"] = (1.0 - w_rem) * 100.0
                    res["weeklyResetTime"] = weekly_bucket.get("resetTime")
                    res["weeklyDescription"] = weekly_bucket.get("description")
                return res

    # 2. Fallback to model catalog fetchAvailableModels
    models_req = urllib.request.Request(
        "https://cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels",
        data=b"{}",
        headers={
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": QUOTA_USER_AGENT,
        },
    )
    with urllib.request.urlopen(models_req, timeout=15) as resp:
        models_data = json.loads(resp.read().decode("utf-8"))

    models = models_data.get("models", {})
    target_info = None
    target_model_name = "Gemini Flash Pool"

    preferred_slugs = ["gemini-3.8-flash-tiered", "gemini-3.5-flash-lite", "gemini-2.5-pro"]
    for slug in preferred_slugs:
        if slug in models and "quotaInfo" in models[slug]:
            target_info = models[slug]["quotaInfo"]
            target_model_name = models[slug].get("displayName", slug)
            break

    if not target_info:
        for m_slug, m_val in models.items():
            if m_val.get("modelProvider") == "MODEL_PROVIDER_GOOGLE" and "quotaInfo" in m_val:
                target_info = m_val["quotaInfo"]
                target_model_name = m_val.get("displayName", m_slug)
                break

    if not target_info:
        raise RuntimeError("No Google Gemini quotaInfo returned by API")

    remaining_fraction = float(target_info.get("remainingFraction", 0.0))
    reset_time_str = target_info.get("resetTime")

    return {
        "modelName": target_model_name,
        "remainingPercent": remaining_fraction * 100.0,
        "usedPercent": (1.0 - remaining_fraction) * 100.0,
        "resetTime": reset_time_str,
    }


def format_time_remaining(reset_time_str: str) -> str:
    if not reset_time_str:
        return "N/A"
    try:
        # ISO format: 2026-11-05T13:42:21Z
        clean_time = reset_time_str.replace("Z", "+00:00")
        reset_dt = datetime.datetime.fromisoformat(clean_time)
        now_dt = datetime.datetime.now(datetime.timezone.utc)
        diff = reset_dt - now_dt
        total_seconds = int(diff.total_seconds())
        if total_seconds <= 0:
            return "ready to reset"
        days, remainder = divmod(total_seconds, 86400)
        hours, remainder = divmod(remainder, 3600)
        minutes, _ = divmod(remainder, 60)
        if days > 0:
            return f"{days}d {hours}h"
        if hours > 0:
            return f"{hours}h {minutes:02d}m"
        return f"{minutes}m"
    except Exception:
        return "N/A"


def format_reset_time(reset_time_str: str) -> str:
    if not reset_time_str:
        return "N/A"
    try:
        clean_time = reset_time_str.replace("Z", "+00:00")
        dt = datetime.datetime.fromisoformat(clean_time)
        return dt.strftime("%Y-%m-%d %H:%M:%S UTC")
    except Exception:
        return reset_time_str


def print_single_account(profile_key: str, as_json: bool = False):
    cfg = ACCOUNT_CONFIGS[profile_key]
    token, err = resolve_account_token(profile_key)
    if err:
        if as_json:
            print(json.dumps({"profile": profile_key, "error": err}))
        else:
            print(f"Error ({profile_key}): {err}", file=sys.stderr)
        return False

    try:
        quota = get_gemini_quota(token)
        if as_json:
            result = {
                "profile": profile_key,
                "displayName": cfg["displayName"],
                **quota,
            }
            print(json.dumps(result, indent=2))
        else:
            time_left = format_time_remaining(quota["resetTime"])
            reset_formatted = format_reset_time(quota["resetTime"])
            print(f"Account:     {profile_key} ({cfg['displayName']})")
            print(f"Gemini Pool: {quota['remainingPercent']:.2f}% remaining ({quota['usedPercent']:.2f}% used)")
            print(f"Resets at:   {reset_formatted} (in {time_left})")
            if "weeklyRemainingPercent" in quota:
                w_time = format_time_remaining(quota.get("weeklyResetTime"))
                print(f"Weekly Pool: {quota['weeklyRemainingPercent']:.2f}% remaining ({quota['weeklyUsedPercent']:.2f}% used, resets in {w_time})")
        return True
    except Exception as e:
        if as_json:
            print(json.dumps({"profile": profile_key, "error": str(e)}))
        else:
            print(f"Error checking {profile_key}: {e}", file=sys.stderr)
        return False


def print_all_accounts(as_json: bool = False):
    results = []
    for p_key, cfg in ACCOUNT_CONFIGS.items():
        token, err = resolve_account_token(p_key)
        if err:
            results.append({"profile": p_key, "displayName": cfg["displayName"], "error": err})
            continue
        try:
            quota = get_gemini_quota(token)
            results.append({
                "profile": p_key,
                "displayName": cfg["displayName"],
                **quota,
            })
        except Exception as e:
            results.append({"profile": p_key, "displayName": cfg["displayName"], "error": str(e)})

    if as_json:
        print(json.dumps(results, indent=2))
        return

    print(f"{'ACCOUNT':<9} {'DISPLAY NAME':<21} {'REMAINING':<11} {'USED':<9} {'RESET TIME (UTC)':<21} {'TIME LEFT'}")
    print("-" * 84)
    for r in results:
        if "error" in r:
            print(f"{r['profile']:<9} {r['displayName']:<21} {'ERROR':<11} {'-':<9} {r['error']}")
        else:
            rem_str = f"{r['remainingPercent']:.2f}%"
            used_str = f"{r['usedPercent']:.2f}%"
            reset_dt = format_reset_time(r['resetTime'])
            time_left = format_time_remaining(r['resetTime'])
            print(f"{r['profile']:<9} {r['displayName']:<21} {rem_str:<11} {used_str:<9} {reset_dt:<21} {time_left}")


def main():
    invoked_name = os.path.basename(sys.argv[0])
    target = None

    if "agyqm47" in invoked_name:
        target = "m47"
    elif "agyqanv" in invoked_name:
        target = "anv"
    elif "agyqmgh" in invoked_name:
        target = "mgh"

    parser = argparse.ArgumentParser(
        description="Check Google Gemini pool quota remaining for Antigravity accounts."
    )
    parser.add_argument(
        "profile",
        nargs="?",
        default=target,
        choices=["m47", "anv", "mgh", "all"],
        help="Account profile to check (default: based on command name or all).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output raw JSON data instead of formatted table.",
    )

    args = parser.parse_args()

    selected = args.profile
    if not selected:
        print_all_accounts(as_json=args.json)
    elif selected == "all":
        print_all_accounts(as_json=args.json)
    else:
        success = print_single_account(selected, as_json=args.json)
        if not success:
            sys.exit(1)


if __name__ == "__main__":
    main()
