#!/usr/bin/env bash
set -euo pipefail

DEFAULT_ORG="${GH_ORG_NAME:-}"
DEFAULT_LIMIT="30"

show_help() {
  cat <<'EOF'
Usage: ghls [org] [gh repo list flags...]

List repositories in a GitHub organization.

Arguments:
  org                   Target GitHub organization or owner (defaults to GH_ORG_NAME)

Options:
  -h, --help            Show this help message and exit

Any other flags are passed directly to 'gh repo list'.

Examples:
  ghls                  # List up to 30 repos in default organization
  ghls --limit 50       # List up to 50 repos in default organization
  ghls other-org        # List repos in another organization
  ghls --json name      # Output repository names as JSON
EOF
}

# Check for help flags
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    show_help
    exit 0
  fi
done

ORG="$DEFAULT_ORG"
HAS_EXPLICIT_LIMIT=0

# If first arg doesn't start with '-', treat it as the target org
if [[ $# -gt 0 && "$1" != -* ]]; then
  ORG="$1"
  shift
fi

if [[ -z "$ORG" ]]; then
  echo "Error: No organization specified and GH_ORG_NAME is not set." >&2
  echo "Usage: ghls [org] [gh repo list flags...]" >&2
  exit 1
fi

# Check if user provided an explicit --limit flag in remaining arguments
for arg in "$@"; do
  if [[ "$arg" == "--limit" || "$arg" == -L* || "$arg" == --limit=* ]]; then
    HAS_EXPLICIT_LIMIT=1
    break
  fi
done

if [[ $HAS_EXPLICIT_LIMIT -eq 1 ]]; then
  exec gh repo list "$ORG" "$@"
else
  exec gh repo list "$ORG" --limit "$DEFAULT_LIMIT" "$@"
fi
