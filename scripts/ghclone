#!/usr/bin/env bash
set -euo pipefail

DEFAULT_ORG="${GH_ORG_NAME:-}"

show_help() {
  cat <<'EOF'
Usage: ghclone <repo> [destination] [options] [gh repo clone / git clone flags...]

Clone a repository from GitHub into ~/ path in the sandbox
and decrypt repository environment secrets from the central environment store (env-store).

Arguments:
  repo                  Repository name (e.g. 'my-repo', 'owner/my-repo', or 'org/repo').
                        If the owner prefix is omitted, GH_ORG_NAME is used.
  destination           Target directory (defaults to ~/<repo-name>).
                        Can be relative or absolute, and '~' is expanded to $HOME.

Options:
  --no-decrypt          Skip automatic decryption of repository environment secrets.
  -h, --help            Show this help message and exit

Any other flags (or flags after '--') are passed directly to 'gh repo clone'.

Examples:
  ghclone my-repo                         # Clones $GH_ORG_NAME/my-repo to ~/my-repo and pulls env from env-store
  ghclone my-repo ~/custom-dir            # Clones $GH_ORG_NAME/my-repo to ~/custom-dir and pulls env from env-store
  ghclone other-org/repo                  # Clones other-org/repo to ~/repo and pulls env from env-store
  ghclone my-repo --no-decrypt            # Clones without decrypting environment secrets
  ghclone my-repo -- --depth 1            # Clones shallow with depth 1
EOF
}

# Check for help flags
for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    show_help
    exit 0
  fi
done

# Separate --no-decrypt / --skip-decrypt from other args
NO_DECRYPT=0
FILTERED_ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--no-decrypt" || "$arg" == "--skip-decrypt" ]]; then
    NO_DECRYPT=1
  else
    FILTERED_ARGS+=("$arg")
  fi
done
set -- "${FILTERED_ARGS[@]+"${FILTERED_ARGS[@]}"}"

if [[ $# -eq 0 || "$1" == -* ]]; then
  echo "Error: No repository specified." >&2
  echo "Usage: ghclone <repo> [destination] [flags...]" >&2
  echo "Run 'ghclone --help' for details." >&2
  exit 1
fi

RAW_REPO="$1"
shift

TARGET_ORG=""
if [[ "$RAW_REPO" == *"/"* ]]; then
  TARGET_REPO="$RAW_REPO"
  TARGET_ORG="${RAW_REPO%%/*}"
else
  if [[ -z "$DEFAULT_ORG" ]]; then
    echo "Error: Target repository '$RAW_REPO' has no owner prefix and GH_ORG_NAME is not set." >&2
    echo "Specify owner/repo or export GH_ORG_NAME." >&2
    exit 1
  fi
  TARGET_REPO="${DEFAULT_ORG}/${RAW_REPO}"
  TARGET_ORG="$DEFAULT_ORG"
fi

REPO_NAME="${TARGET_REPO##*/}"

# Determine destination directory
TARGET_DIR=""
if [[ $# -gt 0 && "$1" != -* ]]; then
  TARGET_DIR="$1"
  shift
fi

# Expand tilde if present, or default to $HOME/$REPO_NAME
if [[ -z "$TARGET_DIR" ]]; then
  TARGET_DIR="${HOME}/${REPO_NAME}"
elif [[ "$TARGET_DIR" == "~" ]]; then
  TARGET_DIR="${HOME}"
elif [[ "$TARGET_DIR" == "~/"* ]]; then
  TARGET_DIR="${HOME}/${TARGET_DIR#"~/"}"
fi

gh repo clone "$TARGET_REPO" "$TARGET_DIR" "$@"

if [[ "$NO_DECRYPT" -eq 0 ]]; then
  pull_cmd=()
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  if command -v pull-repo-env >/dev/null 2>&1; then
    pull_cmd=("pull-repo-env")
  elif command -v pull_repo_env.py >/dev/null 2>&1; then
    pull_cmd=("pull_repo_env.py")
  elif [[ -x "${script_dir}/pull-repo-env" ]]; then
    pull_cmd=("${script_dir}/pull-repo-env")
  elif [[ -x "${script_dir}/pull_repo_env.py" ]]; then
    pull_cmd=("${script_dir}/pull_repo_env.py")
  elif [[ -f "${script_dir}/pull_repo_env.py" ]]; then
    pull_cmd=("python3" "${script_dir}/pull_repo_env.py")
  elif [[ -x "/usr/local/bin/pull-repo-env" ]]; then
    pull_cmd=("/usr/local/bin/pull-repo-env")
  elif [[ -x "/root/.scripts/pull-repo-env" ]]; then
    pull_cmd=("/root/.scripts/pull-repo-env")
  fi

  if [[ ${#pull_cmd[@]} -gt 0 ]]; then
    pull_args=("--optional" "-r" "$REPO_NAME" "-d" "${TARGET_DIR}/.env")
    if [[ -n "$TARGET_ORG" ]]; then
      pull_args+=("-o" "$TARGET_ORG")
    fi
    "${pull_cmd[@]}" "${pull_args[@]}"
  fi
fi
