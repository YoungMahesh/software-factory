{
  "expo": {
    "name": "Base App",
    "slug": "base-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "baseapp",
    "backgroundColor": "#faf9f5",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baseapp.mobile"
    },
    "android": {
      "package": "com.baseapp.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf9f5"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#faf9f5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
