# ==============================================================================
# Factory Environment Configuration (.env.example)
# Copy to .env and configure for local runs or control plane deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Factory Control Plane & Web UI
# ------------------------------------------------------------------------------
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=secretpassword
MODAL_SANDBOX_AUTH_TOKEN=your-sandbox-bearer-token

# ------------------------------------------------------------------------------
# 2. Modal Cloud Authentication
# ------------------------------------------------------------------------------
# Optional when ~/.modal.toml is present locally; required for headless / cloud deploy
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ------------------------------------------------------------------------------
# 3. Source Control & GitHub (Single Organization)
# ------------------------------------------------------------------------------
GH_TOKEN=ghp_your_github_personal_access_token
GH_ORG_NAME=sFactory0

# ------------------------------------------------------------------------------
# 4. Remote Ingress & Access
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
# Optional custom Cloudflare tunnel domain for web ingress display (e.g. 3000.yourdomain.com)
MODAL_SANDBOX_TUNNEL_DOMAIN=
SSH_AUTHORIZED_KEY=

# ------------------------------------------------------------------------------
# 5. AI Tooling & Providers
# ------------------------------------------------------------------------------
OPENCODE_GO_API_KEY=

# Antigravity (Google / Gemini ACP)
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
ANTIGRAVITY_PROJECT_ID=
# JSON array of profile objects (0 to n accounts):
ANTIGRAVITY_TOKENS='[]'

# ------------------------------------------------------------------------------
# 6. Optional Encryption (Target Repository App Decryption Only)
# ------------------------------------------------------------------------------
AGE_PRIVATE_KEY=
