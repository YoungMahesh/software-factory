# ==============================================================================
# Factory Environment Configuration (.env.example)
# Copy to .env and configure for local runs or control plane deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Factory Control Plane & Web UI
# ------------------------------------------------------------------------------
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=secretpassword

# ------------------------------------------------------------------------------
# 2. Modal Cloud Authentication
# ------------------------------------------------------------------------------
# JSON array of Modal account profile objects:
MODAL_TOKENS='[{"name": "work", "token_id": "ak-...", "token_secret": "as-..."}, {"name": "personal", "token_id": "ak-...", "token_secret": "as-...", "active": true}]'

# ------------------------------------------------------------------------------
# 3. Source Control & GitHub (Single Organization)
# ------------------------------------------------------------------------------
GH_TOKEN=ghp_your_github_personal_access_token
GH_ORG_NAME=sFactory0

# ------------------------------------------------------------------------------
# 4. Remote Ingress & Access
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
# Optional custom Cloudflare tunnel domain for web ingress display (e.g. 3000.yourdomain.com)
MODAL_SANDBOX_TUNNEL_DOMAIN=
SSH_AUTHORIZED_KEY=

# ------------------------------------------------------------------------------
# 5. AI Tooling & Providers
# ------------------------------------------------------------------------------
OPENCODE_GO_API_KEY=
# Opt-in pool in the selected Modal workspace and environment (creates -a, -b, -c).
CODEX_PROFILE_VOLUME_PREFIX=
# Optional: use the HTTPS MODAL_SANDBOX_ENDPOINT_URL for pool-wide codexprofile status.
# Configure the same random signing secret on the launch host and hosted control plane.
CODEX_STATUS_SECRET=

# Antigravity (Google / Gemini ACP)
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
# JSON array of profile objects (0 to n accounts):
ANTIGRAVITY_TOKENS='[]'

# ------------------------------------------------------------------------------
# 6. Optional Encryption (Target Repository App Decryption Only)
# ------------------------------------------------------------------------------
AGE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 7. Git Identity (Default Authorship Fallback)
# ------------------------------------------------------------------------------
DEFAULT_GIT_NAME=
DEFAULT_GIT_EMAIL=

# ------------------------------------------------------------------------------
# 8. Documentation Deployment (Cloudflare Pages)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------------------------
# 9. Timezone & Localization
# ------------------------------------------------------------------------------
# Default timezone applied across sandbox containers, git commits, and background processes.
# Examples: Asia/Kolkata (IST, UTC+05:30), UTC, America/New_York, Europe/London
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 10. Resource Plane (Persistence Control Plane: PostgreSQL & S3 Object Storage)
# ------------------------------------------------------------------------------
# Domain name or HTTPS URL of the hosted Resource Plane deployment (falls back to DB_HOST_DOMAIN)
RESOURCE_PLANE_DOMAIN=db-host.mahesh0.dev
# Admin token for MCP authentication (falls back to DB_HOST_ADMIN_TOKEN)
RESOURCE_PLANE_ADMIN_TOKEN=

# Backward-compatible fallbacks:
# DB_HOST_DOMAIN=db-host.mahesh0.dev
# DB_HOST_ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# 11. Resource Plane VPS Deployment Automation (modal-sandbox infra deploy)
# ------------------------------------------------------------------------------
# Remote VPS connection for deploying and managing the Resource Plane
RESOURCE_PLANE_SSH_HOST=
RESOURCE_PLANE_SSH_USER=root
RESOURCE_PLANE_SSH_PORT=22
# Path to private SSH key (Required; canonically placed in .secrets/ and ignored by git)
RESOURCE_PLANE_SSH_KEY=.secrets/resource_plane_ssh
# Target directory on remote VPS for resource-plane deployment
RESOURCE_PLANE_REMOTE_DIR=/opt/resource-plane
# Logical VPS profile folder inside github.com/${GH_ORG_NAME}/caddy-store (Host Ingress Store)
CADDY_STORE_PROFILE=default
