# ==============================================================================
# Dashboard Deployer Configuration (.env.example)
# ==============================================================================

NODE_ENV=production
PORT=3000

# Direct Modal Control Plane origin (*.modal.run) - never set to APPS_BASE_DOMAIN
SANDBOX_CONTROL_PLANE_URL=https://workspace--sandbox-control-plane-fastapi-app.modal.run

# Target App Base Domain where Sandbox Web Dashboard is hosted
APPS_BASE_DOMAIN=apps.example.com

# HTTP Basic Auth credentials matching the Modal Control Plane
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=replace-with-a-strong-password
